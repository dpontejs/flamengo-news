<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Flamengo News — {{ n.edition.label }}</title>
<style>
  body { margin: 0; padding: 0; background-color: #ececec; }
  .wrapper { background-color: #ececec; }
  .container { background-color: #ffffff; }
  .font { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #111111; }
  .header { background-color: #000000; padding: 20px 24px; }
  .brand { color: #ffffff; font-size: 24px; font-weight: 800; letter-spacing: 1px; margin: 0; }
  .brand-red { color: #C3281E; }
  .edition { color: #bbbbbb; font-size: 13px; margin: 4px 0 0 0; }
  .stripe { background-color: #C3281E; height: 5px; line-height: 5px; font-size: 5px; }
  .lead { padding: 24px 24px 8px 24px; }
  .headline { font-size: 24px; font-weight: 800; line-height: 1.25; margin: 0 0 10px 0; color: #000000; }
  .text { font-size: 15px; line-height: 1.55; margin: 0; color: #222222; }
  .muted { color: #666666; font-size: 13px; line-height: 1.5; margin: 0; }
  .block { padding: 12px 24px; }
  .card { border-left: 4px solid #C3281E; background-color: #fafafa; }
  .card-body { padding: 16px 18px; }
  .card-title { color: #C3281E; font-size: 12px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase; margin: 0 0 12px 0; }
  .scoreboard { background-color: #000000; }
  .scoreboard-body { padding: 18px 12px; }
  .team-name { color: #ffffff; font-size: 14px; font-weight: 700; padding-top: 6px; }
  .score { color: #ffffff; font-size: 40px; line-height: 44px; font-weight: 700; }
  .score-x { color: #C3281E; font-size: 20px; line-height: 44px; font-weight: 700; }
  .match-info { color: #bbbbbb; font-size: 12px; padding: 0 12px 14px 12px; }
  .goals { background-color: #1a1a1a; color: #ffffff; font-size: 14px; padding: 10px 16px; }
  .goal-detail { color: #999999; font-size: 12px; }
  .stats td { font-size: 14px; padding: 6px 0; border-bottom: 1px solid #eeeeee; }
  .stat-label { color: #666666; font-size: 13px; }
  .topic { padding: 0 0 18px 0; }
  .topic-title { font-size: 17px; font-weight: 700; margin: 0 0 6px 0; color: #000000; }
  .link { color: #C3281E; text-decoration: none; font-weight: 600; }
  .next-name { font-size: 18px; font-weight: 800; margin: 0 0 4px 0; color: #000000; }
  .table th { font-size: 11px; color: #666666; text-align: left; padding: 6px 4px; border-bottom: 2px solid #000000; }
  .table td { font-size: 14px; padding: 7px 4px; border-bottom: 1px solid #eeeeee; }
  .fla td { font-weight: 800; color: #C3281E; }
  .subhead { font-size: 13px; font-weight: 700; color: #000000; margin: 14px 0 6px 0; }
  .chip { width: 28px; height: 28px; font-size: 13px; font-weight: 800; color: #ffffff; }
  .chip-V { background-color: #1E8E3E; }
  .chip-E { background-color: #8A8A8A; }
  .chip-D { background-color: #C3281E; }
  .kpi { padding: 6px 0; }
  .kpi-value { font-size: 22px; font-weight: 800; color: #000000; }
  .kpi-label { font-size: 12px; color: #666666; }
  .brief { padding: 0 0 14px 0; }
  .brief-title { color: #000000; font-size: 15px; font-weight: 700; text-decoration: none; }
  .tag { background-color: #C3281E; color: #ffffff; font-size: 10px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; padding: 2px 6px; margin-right: 6px; }
  .footer { padding: 20px 24px 28px 24px; color: #777777; font-size: 12px; line-height: 1.5; }
</style>
</head>
<body>
<table role="presentation" class="wrapper" width="100%" cellpadding="0" cellspacing="0" border="0">
<tr><td align="center" style="padding: 16px 8px;">
<table role="presentation" class="container font" width="600" cellpadding="0" cellspacing="0" border="0" style="max-width: 600px;">

  <tr><td class="header font">
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td width="56" valign="middle"><img src="{{ crest }}" alt="Flamengo" width="48" height="48" style="display: block; border: 0;"></td>
      <td valign="middle" style="padding-left: 12px;">
        <p class="brand">FLAMENGO <span class="brand-red">NEWS</span></p>
        <p class="edition">{{ n.edition.label }}</p>
      </td>
    </tr></table>
  </td></tr>
  <tr><td class="stripe">&nbsp;</td></tr>

  <tr><td class="lead font">
    {% if n.headline %}<p class="headline">{{ n.headline }}</p>{% endif %}
    <p class="text">{{ n.intro }}</p>
  </td></tr>

  {% if n.last_match %}{% set m = n.last_match %}
  <tr><td class="block font">
    <p class="card-title" style="margin-top: 8px;">Última partida</p>
    <table role="presentation" class="scoreboard" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td class="scoreboard-body">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
          <td width="35%" align="center" valign="top">
            {% if m.home_logo %}<img src="{{ m.home_logo }}" alt="{{ m.home }}" width="56" height="56" style="display: block; border: 0; margin: 0 auto;">{% endif %}
            <div class="team-name">{{ m.home }}</div>
          </td>
          <td width="30%" align="center" valign="middle">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center"><tr>
              <td class="score" style="vertical-align: middle;">{{ m.home_goals }}</td>
              <td class="score-x" style="vertical-align: middle; padding: 0 12px;">x</td>
              <td class="score" style="vertical-align: middle;">{{ m.away_goals }}</td>
            </tr></table>
          </td>
          <td width="35%" align="center" valign="top">
            {% if m.away_logo %}<img src="{{ m.away_logo }}" alt="{{ m.away }}" width="56" height="56" style="display: block; border: 0; margin: 0 auto;">{% endif %}
            <div class="team-name">{{ m.away }}</div>
          </td>
        </tr></table>
      </td></tr>
      <tr><td class="match-info" align="center">{{ m.competition }} · {{ m.date | when }}{% if m.venue %} · {{ m.venue }}{% endif %}</td></tr>
      {% set goals = m.events | selectattr("type", "equalto", "goal") | list %}
      {% if goals %}
      <tr><td class="goals">
        {% for e in goals %}
        <div>⚽ {{ e | minute }} <strong>{{ e.player }}</strong> <span class="goal-detail">{{ e.team }}{% if e.detail %} · {{ e.detail }}{% endif %}</span></div>
        {% endfor %}
      </td></tr>
      {% endif %}
    </table>
    {% if m.statistics %}
    <table role="presentation" class="stats" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 14px;">
      <tr><td width="30%" style="font-weight: 700;">{{ m.home }}</td><td width="40%" align="center"></td><td width="30%" align="right" style="font-weight: 700;">{{ m.away }}</td></tr>
      {% for label, values in m.statistics.items() %}
      <tr><td>{{ values[0] }}</td><td align="center" class="stat-label">{{ label }}</td><td align="right">{{ values[1] }}</td></tr>
      {% endfor %}
    </table>
    {% endif %}
  </td></tr>
  {% endif %}

  {% set mo = n.moment %}
  {% set leaders = n.last_match.leaders if n.last_match else {} %}
  {% if n.analysis or (mo and (mo.form or mo.standing or mo.rankings)) or leaders %}
  <tr><td class="block font">
    <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="card-body">
      <p class="card-title">Análise</p>
      {% if n.analysis %}<p class="subhead">Leitura do jogo</p><p class="text">{{ n.analysis }}</p>{% endif %}
      {% if mo and mo.form %}
      <p class="subhead">Últimos {{ mo.form | length }} jogos</p>
      <table role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
        {% for f in mo.form %}<td class="chip chip-{{ f.result }}" align="center" title="{{ f.score }} {{ f.opponent }}">{{ f.result }}</td><td width="6"></td>{% endfor %}
      </tr></table>
      <p class="muted" style="margin-top: 6px;">{% for f in mo.form %}{{ f.score }} {{ f.opponent }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
      {% endif %}
      {% if mo and mo.standing %}{% set s = mo.standing %}
      <p class="subhead">Campanha no Brasileirão</p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
        <td width="33%" class="kpi"><span class="kpi-value">{{ s.position }}º</span><br><span class="kpi-label">{{ s.points }} pontos</span></td>
        <td width="33%" class="kpi"><span class="kpi-value">{{ s | performance }}</span><br><span class="kpi-label">aproveitamento</span></td>
        <td width="34%" class="kpi"><span class="kpi-value">{{ s.goals_for }}</span><br><span class="kpi-label">{{ s.goals_for }} gols pró · {{ s.goals_against }} contra</span></td>
      </tr></table>
      {% if mo.gap %}<p class="muted" style="margin-top: 6px;">Na tabela: {{ mo.gap }}.</p>{% endif %}
      {% endif %}
      {% if mo and mo.rankings %}
      <p class="subhead">Rankings do campeonato</p>
      {% for r in mo.rankings %}<p class="text">{{ r.player }} · {{ r.position }}º em {{ r.category | lower }} ({{ r.value }})</p>{% endfor %}
      {% endif %}
      {% if leaders.get("Flamengo") %}
      <p class="subhead">Destaques do Flamengo na partida</p>
      {% for label, player, value in leaders["Flamengo"] %}<p class="text">{{ label }}: <strong>{{ player }}</strong> ({{ value }})</p>{% endfor %}
      {% endif %}
    </td></tr></table>
  </td></tr>
  {% endif %}

  {% if n.topics %}
  <tr><td class="block font">
    <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="card-body">
      <p class="card-title">Notícias</p>
      {% for t in n.topics %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="topic">
        <p class="topic-title">{{ t.title }}</p>
        {% if t.summary %}<p class="text">{{ t.summary }}</p>{% endif %}
        {% if t.articles %}<p class="muted" style="margin-top: 6px;">Fontes: {% for a in t.articles %}<a class="link" href="{{ a.url }}">{{ a.source | source }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
      </td></tr></table>
      {% endfor %}
    </td></tr></table>
  </td></tr>
  {% endif %}

  {% for section_title, items in [("Saiba mais", n.learn_more), ("Brasil afora", n.around_brazil)] if items %}
  <tr><td class="block font">
    <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="card-body">
      <p class="card-title">{{ section_title }}</p>
      {% for b in items %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="brief">
        {% if b.category %}<span class="tag">{{ b.category }}</span>{% endif %}
        <a class="brief-title" href="{{ b.url }}">{{ b.title }}</a>
        {% if b.summary %}<p class="text" style="margin-top: 4px;">{{ b.summary }}</p>{% endif %}
        <p class="muted" style="margin-top: 2px;">{{ b.source | source }}</p>
      </td></tr></table>
      {% endfor %}
    </td></tr></table>
  </td></tr>
  {% endfor %}

  {% if n.next_match %}{% set x = n.next_match %}
  <tr><td class="block font">
    <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="card-body">
      <p class="card-title">Próximo jogo</p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
        {% if x.opponent_logo %}<td width="56" valign="middle"><img src="{{ x.opponent_logo }}" alt="{{ x.opponent }}" width="44" height="44" style="display: block; border: 0;"></td>{% endif %}
        <td valign="middle">
          <p class="next-name">{% if x.is_home %}Flamengo x {{ x.opponent }}{% else %}{{ x.opponent }} x Flamengo{% endif %}</p>
          <p class="muted">{{ x.competition }} · {{ x.date | when }}{% if x.venue %} · {{ x.venue }}{% endif %}</p>
        </td>
      </tr></table>
    </td></tr></table>
  </td></tr>
  {% endif %}

  {% if standings %}
  <tr><td class="block font">
    <table role="presentation" class="card" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="card-body">
      <p class="card-title">Classificação · Brasileirão</p>
      <table role="presentation" class="table" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr><th>#</th><th>Time</th><th>P</th><th>J</th><th>V</th><th>E</th><th>D</th><th>SG</th></tr>
        {% for r in standings %}
        <tr{% if r.is_flamengo %} class="fla"{% endif %}><td>{{ r.position }}</td><td>{{ r.team }}</td><td>{{ r.points }}</td><td>{{ r.played }}</td><td>{{ r.won }}</td><td>{{ r.drawn }}</td><td>{{ r.lost }}</td><td>{{ r.goals_diff }}</td></tr>
        {% endfor %}
      </table>
    </td></tr></table>
  </td></tr>
  {% endif %}

  <tr><td class="footer font">
    Resumo gerado com IA a partir das fontes citadas; confira os links para detalhes. Escudos e dados: ESPN.
    {% if subscribe_url %}<br>Recebeu de alguém? Inscreva-se em <a class="link" href="{{ subscribe_url }}">{{ subscribe_url | replace("https://", "") }}</a>.{% endif %}
    {% if unsubscribe_url %}<br>Não quer mais receber? <a class="link" href="{{ unsubscribe_url }}">Clique para se descadastrar</a>.{% endif %}
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
